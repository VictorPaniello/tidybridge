# Copy to .env.local for local development (Vite convention - loaded
# automatically, gitignored). Real value in production is set in Vercel's
# project settings.
VITE_API_URL=http://localhost:8000

# Optional: only set on the staging environment in Vercel, matching
# STAGING_GATE_PASSWORD on the staging API - see api/client.ts. Every
# other build (local dev, production) leaves this unset.
VITE_STAGING_GATE_PASSWORD=
